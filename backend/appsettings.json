{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ScheduledReminders",
    "Audience": "ScheduledReminders.Api",
    "ExpiryHours": 8,
    "Key": ""
  },
  "ReminderProcessor": {
    "PollIntervalSeconds": 1,
    "SimulationDelaySeconds": 10
  }
}
